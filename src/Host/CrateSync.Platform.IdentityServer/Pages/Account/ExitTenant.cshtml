@page
@model CrateSync.Platform.IdentityServer.Pages.Account.ExitTenantModel
@{
    ViewData["Title"] = "Change workspace";
}

<div class="card">
    <h1>Change workspace</h1>

    <p class="help">
        Leave the current organisation and continue to your available workspaces.
    </p>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <button type="submit">
            Continue
        </button>
    </form>
</div>
